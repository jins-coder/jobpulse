{
  "manifest_version": 3,
  "name": "JobPulse :: ATS Application Copilot",
  "version": "1.0.0",
  "description": "1-Click AI Autofiller & Tailored Application Copilot for Greenhouse, Lever, Workday, Ashby, and LinkedIn.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPulse Application Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
